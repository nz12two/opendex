---
import type { HallOfFameEntry } from "../data/community";
import { Trophy, Quote } from "lucide-react";

interface Props {
  entries: HallOfFameEntry[];
}

const { entries } = Astro.props;
---

<div class="space-y-6">
  {entries.map((entry) => (
    <div
      key={entry.name}
      class="group relative rounded-lg border border-border/50 bg-card p-5 transition-all hover:border-amber-500/30 hover:shadow-md hover:shadow-amber-500/5"
    >
      <div class="flex items-start gap-4">
        <!-- Avatar -->
        <div class="relative shrink-0">
          <div class="absolute -inset-1 rounded-full bg-gradient-to-br from-amber-400/30 to-amber-600/10 opacity-0 group-hover:opacity-100 transition-opacity blur-sm" />
          <img
            src={entry.avatar}
            alt={entry.name}
            class="relative h-14 w-14 rounded-full border-2 border-amber-500/30 object-cover"
            loading="lazy"
          />
        </div>

        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <h3 class="font-semibold text-card-foreground group-hover:text-amber-400 transition-colors">
              {entry.name}
            </h3>
            <Trophy class="h-4 w-4 text-amber-400" />
          </div>

          <p class="mt-1 text-sm text-muted-foreground">
            {entry.year}
          </p>

          <!-- Contribution Quote -->
          <div class="mt-3 flex gap-2 rounded-md bg-muted/30 p-3">
            <Quote class="h-4 w-4 shrink-0 text-amber-400/60 mt-0.5" />
            <p class="text-sm text-muted-foreground italic">
              {entry.contribution}
            </p>
          </div>

          <!-- GitHub Link -->
          <a
            href={`https://github.com/${entry.github}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-primary transition-colors"
          >
            @{entry.github} no GitHub
          </a>
        </div>
      </div>
    </div>
  ))}
</div>
