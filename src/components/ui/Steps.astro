---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<div class="my-6">
  {title && (
    <h3 class="mb-4 text-lg font-semibold text-foreground">{title}</h3>
  )}
  <ol class="relative space-y-6 border-l-2 border-primary/20 pl-8">
    <slot />
  </ol>
</div>

<style define:vars={{}}>
  ol :global(li) {
    @apply relative list-none;
  }

  ol :global(li::before) {
    @apply absolute -left-8 flex h-7 w-7 items-center justify-center rounded-full bg-primary/10 text-sm font-semibold text-primary;
    content: counter(list-item);
    counter-increment: list-item;
  }
</style>
