---
import { cn } from '@/lib/utils';

interface Props {
  chart: string;
  title?: string;
  caption?: string;
}

const { chart, title, caption } = Astro.props;
const id = `mermaid-${Math.random().toString(36).substring(2, 10)}`;
---

<figure class="my-6">
  {title && (
    <figcaption class="mb-2 text-sm font-medium text-foreground">{title}</figcaption>
  )}
  <div
    id={id}
    class={cn(
      'flex min-h-[120px] items-center justify-center rounded-lg border border-border/50 bg-card p-6',
      'overflow-x-auto',
    )}
  >
    <div class="mermaid-container w-full">
      <pre class="mermaid-source overflow-x-auto text-sm text-muted-foreground"><code>{chart}</code></pre>
      <div class="mt-3 flex items-center justify-center gap-2 text-xs text-muted-foreground/60">
        <span class="inline-block h-3 w-3 rounded-full bg-primary/20 animate-pulse" />
        <span>Diagrama interativo disponível com JavaScript</span>
      </div>
    </div>
  </div>
  {caption && (
    <figcaption class="mt-2 text-center text-xs text-muted-foreground">{caption}</figcaption>
  )}
</figure>
