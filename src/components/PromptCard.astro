---
import type { Prompt } from '@/data/prompts/types';
import TagBadge from './TagBadge.astro';
import { FileText, ChevronRight } from 'lucide-react';

interface Props {
  prompt: Prompt;
}

const { prompt } = Astro.props;

const categoryColors: Record<string, string> = {
  'Desenvolvimento': 'bg-blue-500/10 text-blue-500 border-blue-500/20',
  'Manutenção': 'bg-amber-500/10 text-amber-500 border-amber-500/20',
  'Depuração': 'bg-red-500/10 text-red-500 border-red-500/20',
  'Docs': 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20',
  'Design': 'bg-purple-500/10 text-purple-500 border-purple-500/20',
  'QA': 'bg-cyan-500/10 text-cyan-500 border-cyan-500/20',
};
---

<a
  href={`/opendex/prompts/${prompt.slug}`}
  class="group relative flex flex-col rounded-lg border border-border/50 bg-card p-6 card-hover"
>
  <!-- Header -->
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
        <FileText class="h-5 w-5 text-primary" />
      </div>
      <div>
        <h3 class="font-semibold text-card-foreground group-hover:text-primary transition-colors">
          {prompt.name}
        </h3>
        <span
          class={`mt-0.5 inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium ${
            categoryColors[prompt.category] || 'bg-muted text-muted-foreground border-transparent'
          }`}
        >
          {prompt.category}
        </span>
      </div>
    </div>
    <ChevronRight class="h-4 w-4 text-muted-foreground/40 group-hover:text-primary transition-colors shrink-0 mt-1" />
  </div>

  <!-- Description -->
  <p class="mt-3 text-sm text-muted-foreground line-clamp-2">
    {prompt.description}
  </p>

  <!-- Preview of content -->
  <div class="mt-3 rounded-md bg-muted/30 p-3">
    <p class="text-xs text-muted-foreground line-clamp-2 font-mono">
      {prompt.content.slice(0, 120)}
      {prompt.content.length > 120 ? '...' : ''}
    </p>
  </div>

  <!-- Tags -->
  <div class="mt-4 flex flex-wrap gap-1.5">
    {prompt.tags.slice(0, 4).map((tag) => (
      <TagBadge tag={tag} />
    ))}
    {prompt.tags.length > 4 && (
      <span class="text-[10px] text-muted-foreground self-center">
        +{prompt.tags.length - 4}
      </span>
    )}
  </div>
</a>
