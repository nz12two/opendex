---
import { projects } from "../data/showcase";
import { Sparkles, Star, ArrowRight } from "lucide-react";

const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);
---

<div class="rounded-lg border border-border bg-card p-5">
  <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold">
    <Sparkles class="h-4 w-4 text-primary" />
    Community Showcase
  </h3>

  {featuredProjects.length > 0 ? (
    <ul class="space-y-3">
      {featuredProjects.map((project) => (
        <li>
          <a
            href={`/opendex/showcase/${project.slug}/`}
            class="group block rounded-md border border-border/50 bg-muted/30 p-3 transition-all hover:border-primary/30 hover:bg-primary/5"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="text-sm font-medium text-card-foreground group-hover:text-primary transition-colors">
                {project.name}
              </span>
              {project.featured && (
                <Star class="h-3.5 w-3.5 shrink-0 fill-amber-400 text-amber-400" />
              )}
            </div>
            <p class="mt-1 text-xs text-muted-foreground line-clamp-2">
              {project.description}
            </p>
            <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
              <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-2 py-0.5 text-[10px] font-medium text-primary">
                {project.type}
              </span>
              <span>por {project.author}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="text-sm text-muted-foreground">
      Nenhum projeto em destaque no momento.
    </p>
  )}

  <a
    href="/opendex/showcase/"
    class="mt-3 flex items-center justify-center gap-1.5 rounded-lg border border-border px-3 py-2 text-xs font-medium text-muted-foreground transition-all hover:border-primary/30 hover:text-primary"
  >
    Ver todos os projetos
    <ArrowRight class="h-3.5 w-3.5" />
  </a>
</div>
