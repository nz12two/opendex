---
import type { CollectionEntry } from "astro:content";
import BlogCard from "./BlogCard.astro";

interface Props {
  posts: CollectionEntry<"blog">[];
  featured?: CollectionEntry<"blog">[];
}

const { posts, featured } = Astro.props;
---

<!-- Featured Posts -->
{featureed && featured.length > 0 && (
  <section class="mb-12">
    <h2 class="mb-6 flex items-center gap-2 text-xl font-bold">
      <span class="h-1.5 w-1.5 rounded-full bg-primary" />
      Destaques
    </h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {featured.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
)}

<!-- All Posts -->
<section>
  <h2 class="mb-6 text-xl font-bold">Todos os artigos</h2>
  {posts.length > 0 ? (
    <div class="grid gap-6 sm:grid-cols-2">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  ) : (
    <div class="py-16 text-center">
      <div class="inline-flex items-center justify-center rounded-full bg-muted p-4">
        <span class="text-2xl">📝</span>
      </div>
      <h3 class="mt-4 text-lg font-semibold">Nenhum artigo publicado ainda</h3>
      <p class="mt-2 text-sm text-muted-foreground">
        Volte em breve para novos conteúdos.
      </p>
    </div>
  )}
</section>
