---
import type { Model } from '@/data/models/types';
import { getCategoryLabel, getCategoryColor } from '@/data/models';
import { cn } from '@/lib/utils';
import { Star, Zap, Brain, Gauge, ArrowRight } from 'lucide-react';

interface Props {
  model: Model;
}

const { model } = Astro.props;
---

<a
  href={`/opendex/modelos/${model.slug}`}
  class="group relative flex flex-col rounded-lg border border-border/50 bg-card p-6 card-hover"
>
  <!-- Category Badge -->
  <div class="absolute right-4 top-4">
    <span class={cn('inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium', getCategoryColor(model.category))}>
      {getCategoryLabel(model.category)}
    </span>
  </div>

  <!-- Header -->
  <div class="flex items-start gap-4">
    <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 shrink-0">
      <Brain class="h-6 w-6 text-primary" />
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="font-semibold text-card-foreground group-hover:text-primary transition-colors text-lg">
        {model.name}
      </h3>
      {model.provider && (
        <p class="text-xs text-muted-foreground">{model.provider}</p>
      )}
    </div>
  </div>

  <!-- Description -->
  <p class="mt-3 text-sm text-muted-foreground line-clamp-2">
    {model.description}
  </p>

  <!-- Stats -->
  <div class="mt-4 grid grid-cols-3 gap-3 rounded-md bg-muted/50 p-3 text-xs">
    <div class="text-center">
      <div class="flex items-center justify-center gap-1 text-muted-foreground mb-1">
        <Zap class="h-3 w-3" />
        <span>Speed</span>
      </div>
      <div class="flex items-center justify-center gap-0.5">
        {Array.from({ length: 5 }).map((_, i) => (
          <div key={i} class={cn('h-1.5 w-3 rounded-full', i < model.speed ? 'bg-amber-500' : 'bg-muted')} />
        ))}
      </div>
    </div>
    <div class="text-center">
      <div class="flex items-center justify-center gap-1 text-muted-foreground mb-1">
        <Star class="h-3 w-3" />
        <span>Quality</span>
      </div>
      <div class="flex items-center justify-center gap-0.5">
        {Array.from({ length: 5 }).map((_, i) => (
          <div key={i} class={cn('h-1.5 w-3 rounded-full', i < model.quality ? 'bg-violet-500' : 'bg-muted')} />
        ))}
      </div>
    </div>
    <div class="text-center">
      <div class="flex items-center justify-center gap-1 text-muted-foreground mb-1">
        <Gauge class="h-3 w-3" />
        <span>Rating</span>
      </div>
      <span class="font-semibold text-foreground">{model.communityRating}</span>
    </div>
  </div>

  <!-- Info Tags -->
  <div class="mt-3 flex flex-wrap gap-1.5 text-xs">
    <span class="rounded-md bg-muted/50 px-2 py-0.5 text-muted-foreground">
      {model.price}
    </span>
    <span class="rounded-md bg-muted/50 px-2 py-0.5 text-muted-foreground">
      {model.context >= 1000000 ? `${(model.context / 1000000).toFixed(0)}M` : `${(model.context / 1000).toFixed(0)}K`} ctx
    </span>
    {model.toolCalling && (
      <span class="rounded-md bg-primary/10 px-2 py-0.5 text-primary">Tool Calling</span>
    )}
    {model.reasoning && (
      <span class="rounded-md bg-emerald-500/10 px-2 py-0.5 text-emerald-400">Reasoning</span>
    )}
  </div>

  <!-- Footer -->
  <div class="mt-4 flex items-center justify-between">
    <div class="flex items-center gap-1 text-xs text-muted-foreground">
      <Star class="h-3 w-3 text-amber-500" />
      <span>{model.communityRating}/5.0</span>
    </div>
    <ArrowRight class="h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors" />
  </div>
</a>


