---
import { cn } from '@/lib/utils';

interface ComparisonRow {
  feature: string;
  values: { label: string; value: string }[];
}

interface Props {
  headers: string[];
  rows: ComparisonRow[];
}

const { headers, rows } = Astro.props;
---

<div class="overflow-x-auto rounded-lg border border-border">
  <table class="w-full text-sm">
    <thead>
      <tr class="border-b border-border bg-muted/50">
        <th class="px-4 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
          Característica
        </th>
        {headers.map((header) => (
          <th key={header} class="px-4 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider">
            {header}
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      {rows.map((row, i) => (
        <tr key={i} class={cn('transition-colors', i % 2 === 0 ? 'bg-card' : 'bg-muted/30')}>
          <td class="px-4 py-3 font-medium text-foreground whitespace-nowrap">
            {row.feature}
          </td>
          {row.values.map((v) => (
            <td key={v.label} class="px-4 py-3 text-muted-foreground">
              {v.value}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>


