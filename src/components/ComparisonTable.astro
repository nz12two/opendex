---
import type { Comparison } from '@/data/comparisons/types';

interface Props {
  comparison: Comparison;
}

const { comparison } = Astro.props;
---

<div class="overflow-hidden rounded-lg border border-border">
  <table class="w-full">
    <thead>
      <tr class="border-b border-border bg-muted/50">
        <th class="px-4 py-3 text-left text-sm font-semibold text-foreground">Feature</th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-primary">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded bg-primary/10 text-xs font-bold text-primary">OC</span>
            OpenCode
          </div>
        </th>
        <th class="px-4 py-3 text-left text-sm font-semibold text-muted-foreground">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 items-center justify-center rounded bg-muted text-xs font-bold text-muted-foreground">VS</span>
            {comparison.tool}
          </div>
        </th>
      </tr>
    </thead>
    <tbody>
      {comparison.table.map((row, i) => (
        <tr class={i < comparison.table.length - 1 ? 'border-b border-border' : ''}>
          <td class="px-4 py-3 text-sm font-medium text-foreground">{row.feature}</td>
          <td class="px-4 py-3 text-sm text-emerald-600 dark:text-emerald-400">{row.opencode}</td>
          <td class="px-4 py-3 text-sm text-muted-foreground">{row.other}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
