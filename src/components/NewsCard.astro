---
import type { NewsItem } from '@/data/news/types';
import TagBadge from './TagBadge.astro';
import { Rocket, Puzzle, BrainCircuit, GitPullRequest, Map, Trophy, Users, ExternalLink } from 'lucide-react';

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;

const iconMap: Record<string, any> = {
  Rocket,
  Puzzle,
  BrainCircuit,
  GitPullRequest,
  Map,
  Trophy,
  Users,
};
const Icon = iconMap[item.icon] || Rocket;

const typeColors: Record<string, string> = {
  release: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20',
  plugin: 'bg-blue-500/10 text-blue-500 border-blue-500/20',
  pr: 'bg-amber-500/10 text-amber-500 border-amber-500/20',
  roadmap: 'bg-purple-500/10 text-purple-500 border-purple-500/20',
  event: 'bg-rose-500/10 text-rose-500 border-rose-500/20',
  community: 'bg-cyan-500/10 text-cyan-500 border-cyan-500/20',
};

const typeLabels: Record<string, string> = {
  release: 'Release',
  plugin: 'Plugin',
  pr: 'Pull Request',
  roadmap: 'Roadmap',
  event: 'Evento',
  community: 'Comunidade',
};
---

<article class="group relative rounded-xl border border-border/50 bg-card p-6 transition-all hover:border-primary/50 hover:shadow-md hover:shadow-primary/5">
  <div class="flex items-start gap-4">
    <!-- Icon -->
    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 shrink-0 ring-1 ring-primary/20">
      <Icon class="h-5 w-5 text-primary" />
    </div>

    <div class="min-w-0 flex-1">
      <!-- Meta -->
      <div class="flex items-center gap-2 flex-wrap">
        <span class={`inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium ${typeColors[item.type] || ''}`}>
          {typeLabels[item.type] || item.type}
        </span>
        <time class="text-xs text-muted-foreground">{item.date}</time>
        {item.source && (
          <span class="text-xs text-muted-foreground">· {item.source}</span>
        )}
        {item.author && (
          <span class="text-xs text-muted-foreground">· {item.author}</span>
        )}
      </div>

      <!-- Title -->
      <h3 class="mt-2 font-semibold text-card-foreground group-hover:text-primary transition-colors">
        {item.url ? (
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="group-hover:text-primary transition-colors">
            {item.title}
            <ExternalLink class="inline-block h-3.5 w-3.5 ml-1 text-muted-foreground group-hover:text-primary align-[-2px]" />
          </a>
        ) : (
          item.title
        )}
      </h3>

      <!-- Description -->
      <p class="mt-1 text-sm text-muted-foreground">
        {item.description}
      </p>

      <!-- Tags -->
      {item.tags && item.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-1.5">
          {item.tags.map(tag => (
            <TagBadge tag={tag} variant="outline" size="sm" />
          ))}
        </div>
      )}
    </div>
  </div>
</article>
