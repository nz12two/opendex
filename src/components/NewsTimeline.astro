---
import type { NewsItem } from '@/data/news/types';
import NewsCard from './NewsCard.astro';

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;

// Sort by date descending
const sorted = [...items].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Group by month
interface MonthGroup {
  label: string;
  items: NewsItem[];
}

const groups: MonthGroup[] = [];
sorted.forEach(item => {
  const date = new Date(item.date);
  const label = date.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
  const last = groups[groups.length - 1];
  if (last && last.label === label) {
    last.items.push(item);
  } else {
    groups.push({ label, items: [item] });
  }
});
---

<div class="relative">
  <!-- Timeline line -->
  <div class="absolute left-[19px] top-0 bottom-0 w-px bg-border/60 hidden sm:block" />

  <div class="space-y-10">
    {groups.map(group => (
      <div key={group.label}>
        {/* Month header */}
        <div class="flex items-center gap-4 mb-6">
          <div class="relative z-10 flex h-10 w-10 items-center justify-center rounded-full border border-border bg-background shrink-0">
            <span class="h-2.5 w-2.5 rounded-full bg-primary" />
          </div>
          <h3 class="text-sm font-semibold text-muted-foreground capitalize">
            {group.label}
          </h3>
          <div class="flex-1 h-px bg-border/40" />
        </div>

        {/* Items */}
        <div class="space-y-4 pl-14 sm:pl-0">
          {group.items.map(item => (
            <div key={item.id} class="relative">
              {/* Timeline dot connector (desktop) */}
              <div class="absolute left-[-34px] top-6 hidden sm:block">
                <div class="h-2 w-2 rounded-full border-2 border-primary/40 bg-background" />
              </div>
              <NewsCard item={item} />
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
