---
export interface Props {
  method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE' | 'HEAD' | 'OPTIONS';
}

const { method } = Astro.props;
const colors: Record<string, string> = {
  GET: 'bg-green-500/10 text-green-400 border-green-500/20',
  POST: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  PUT: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
  PATCH: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  DELETE: 'bg-red-500/10 text-red-400 border-red-500/20',
  HEAD: 'bg-gray-500/10 text-gray-400 border-gray-500/20',
  OPTIONS: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
};
---
<span class={`inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-xs font-bold ${colors[method] || colors.GET}`}>
  {method}
</span>
