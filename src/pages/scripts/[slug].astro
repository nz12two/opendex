---
import MainLayout from "../../layouts/MainLayout.astro";
import TagBadge from "../../components/TagBadge.astro";
import ContentTags from "../../components/ContentTags.astro";
import DidYouKnow from "../../components/DidYouKnow.tsx";
import FavoriteButton from "../../components/FavoriteButton";
import { getScriptBySlug, scripts } from "../../data/scripts";
import { ArrowLeft, ExternalLink, Github, Package, Download } from "lucide-react";

export async function getStaticPaths() {
  return scripts.map((script) => ({
    params: { slug: script.slug },
    props: { script },
  }));
}

const { script } = Astro.props;

if (!script) {
  return Astro.redirect("/opendex/404");
}

const relatedScripts = scripts
  .filter((s) => s.slug !== script.slug && (s.category === script.category || s.tags.some((t) => script.tags.includes(t))))
  .slice(0, 3);

function getGitHubUrl(repo: string | null): string | null {
  if (!repo) return null;
  const match = repo.match(
    /(?:https?:\/\/|git@|git\+https?:\/\/)(?:www\.)?(?:github\.com\/)([^/]+\/[^/.]+)/i,
  );
  if (match) return `https://github.com/${match[1]}`;
  if (repo.includes('github.com')) {
    const m = repo.match(/(https?:\/\/github\.com\/[^/\s]+(?:\/[^/\s]+?)?)/i);
    if (m) return m[1]?.replace(/\.git$/, '');
  }
  return null;
}

const githubUrl = getGitHubUrl(script.repository);
---

<MainLayout title={`${script.name} — Scripts — OpenDex`} description={script.description}>
  <!-- Breadcrumb -->
  <div class="border-b border-border/40 px-4 py-3">
    <div class="container mx-auto max-w-4xl">
      <nav class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/opendex/scripts/" class="hover:text-foreground transition-colors">Scripts</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-foreground font-medium">{script.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-10 pb-12 md:pt-16 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-4xl relative">
      <a href="/opendex/scripts/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
        <ArrowLeft class="h-4 w-4" />
        Voltar para Scripts
      </a>
      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3">
            <span class="rounded-md bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
              {script.category}
            </span>
            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-400 border border-emerald-500/20">v{script.version}</span>
          </div>
          <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl">
            {script.name}
          </h1>
          <p class="mt-3 text-lg text-muted-foreground">
            {script.description}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            {script.tags?.length > 0 && <ContentTags tags={script.tags} />}
          </div>
          <div class="mt-4 flex items-center gap-4 text-sm text-muted-foreground">
            <span>{script.downloads.toLocaleString()} downloads/mês</span>
            <span>•</span>
            <span>publicado por <span class="font-medium text-foreground">{script.author}</span></span>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <a
            href={script.npm}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:bg-primary/90"
          >
            <ExternalLink class="h-4 w-4" />
            Ver no npm
          </a>
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-background px-5 py-2.5 text-sm font-medium transition-colors hover:bg-muted"
            >
              <Github class="h-4 w-4" />
              GitHub
            </a>
          )}
          <FavoriteButton
            type="script"
            slug={script.slug}
            title={script.name}
            url={script.npm}
            client:load
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <div class="container mx-auto max-w-4xl px-4 py-10">
    <div class="grid gap-10 lg:grid-cols-3">
      <!-- Main -->
      <div class="lg:col-span-2 space-y-10">
        <section>
          <h2 class="text-xl font-bold mb-4">Descrição</h2>
          <p class="text-muted-foreground leading-relaxed">
            {script.description}
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold mb-4">Instalação</h2>
          <div class="relative">
            <pre class="rounded-md bg-muted p-3 text-sm font-mono overflow-x-auto">$ npm install {script.name}</pre>
            <button
              class="copy-mini absolute right-2 top-2 rounded p-1 text-muted-foreground hover:text-foreground"
              data-code={`npm install ${script.name}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="rounded-lg border border-border bg-card p-5">
          <h3 class="font-semibold mb-3">Informações</h3>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Autor</dt>
              <dd class="font-medium">{script.author}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Categoria</dt>
              <dd class="font-medium">{script.category}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Versão</dt>
              <dd class="font-medium">{script.version}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Downloads/mês</dt>
              <dd class="font-medium">{script.downloads.toLocaleString()}</dd>
            </div>
          </dl>
        </div>

        <!-- Tags -->
        <div class="rounded-lg border border-border bg-card p-5">
          <h3 class="font-semibold mb-3">Tags</h3>
          <div class="flex flex-wrap gap-1.5">
            {script.tags.map((tag) => (
              <TagBadge tag={tag} variant="primary" />
            ))}
          </div>
        </div>

        <!-- Fonte -->
        <div class="rounded-lg border border-border bg-card p-5">
          <h3 class="font-semibold mb-3">Fonte</h3>
          <a
            href={script.npm}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-primary hover:underline break-all"
          >
            {script.npm}
          </a>
          <p class="mt-2 text-xs text-muted-foreground">
            Dados do registro npm (snapshot do ecossistema OpenCode).
          </p>
        </div>
      </aside>
    </div>

    <!-- Did You Know -->
    <div class="mt-16">
      <DidYouKnow />
    </div>

    <!-- Related -->
    {relatedScripts.length > 0 && (
      <section class="mt-16 border-t border-border/40 pt-10">
        <h2 class="text-xl font-bold mb-6">Scripts relacionados</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedScripts.map((related) => (
            <a
              href={related.npm}
              target="_blank"
              rel="noopener noreferrer"
              class="group rounded-lg border border-border/50 bg-card p-4 transition-all hover:border-primary/30"
            >
              <div class="flex items-center justify-between mb-2">
                <span class="rounded-md bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                  {related.category}
                </span>
                <ExternalLink class="h-3 w-3 text-muted-foreground" />
              </div>
              <h3 class="font-semibold group-hover:text-primary transition-colors">{related.name}</h3>
              <p class="mt-1 text-sm text-muted-foreground line-clamp-2">{related.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</MainLayout>

<script>
  document.querySelectorAll(".copy-mini").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = btn.getAttribute("data-code");
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        btn.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><path d="M20 6 9 17l-5-5"/></svg>';
        setTimeout(() => {
          btn.innerHTML =
            '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
        }, 2000);
      } catch {
        // ignore
      }
    });
  });
</script>
