---
import MainLayout from "../../layouts/MainLayout.astro";
import GitHubCard from "../../components/GitHubCard.astro";
import GitHubFilters from "../../components/GitHubFilters.astro";
import LiveGitHubStats from "../../components/LiveGitHubStats.tsx";
import EcosystemStats from "../../components/EcosystemStats.tsx";
import { githubRepos, getLanguages, getTotalStars } from "../../data/github";
import { Github, Sparkles, Star, Activity } from "lucide-react";

const languages = getLanguages();
const totalStars = getTotalStars();
---

<MainLayout
  title="Explorador GitHub — OpenDex"
  description="Explore os repositórios do ecossistema OpenCode — métricas, linguagens e links diretos."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-hero">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <Github class="h-4 w-4 text-primary" />
        <span>GitHub Explorer</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Explorador <span class="text-gradient">GitHub</span>
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Repositórios do ecossistema OpenCode — métricas, linguagens e links diretos para o código fonte.
      </p>

      <div class="mx-auto mt-8 flex items-center justify-center gap-6">
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <Github class="h-4 w-4 text-primary" />
          <span><strong class="text-foreground">{githubRepos.length}</strong> repositórios</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <Star class="h-4 w-4 fill-yellow-500 text-yellow-500" />
          <span><strong class="text-foreground">{totalStars.toLocaleString()}</strong> estrelas</span>
        </div>
        <div class="flex items-center gap-2 text-sm text-muted-foreground">
          <Sparkles class="h-4 w-4 text-primary" />
          <span><strong class="text-foreground">{languages.length}</strong> linguagens</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Section -->
  <section class="border-b border-border/40 px-4 py-10">
    <div class="container mx-auto max-w-6xl">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10">
          <Activity class="h-4 w-4 text-primary" />
        </div>
        <div>
          <h2 class="text-lg font-semibold text-foreground">Métricas ao Vivo</h2>
          <p class="text-xs text-muted-foreground">
            Dados em tempo real da API pública do GitHub
          </p>
        </div>
      </div>
      <LiveGitHubStats client:load />
    </div>
  </section>

  <!-- Ecosystem Stats -->
  <section class="border-b border-border/40 px-4 py-10">
    <div class="container mx-auto max-w-6xl">
      <div class="mb-6 flex items-center gap-3">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <h2 class="text-lg font-semibold text-foreground">Estatísticas do Ecossistema</h2>
          <p class="text-xs text-muted-foreground">
            Métricas agregadas de pacotes npm, repositórios GitHub e recursos
          </p>
        </div>
      </div>
      <EcosystemStats client:load />
    </div>
  </section>

  <!-- Filters -->
  <section class="border-b border-border/40 px-4 py-4">
    <div class="container mx-auto max-w-6xl">
      <GitHubFilters languages={languages} activeLanguage="all" totalCount={githubRepos.length} />
    </div>
  </section>

  <!-- Grid -->
  <section class="px-4 py-10">
    <div class="container mx-auto max-w-6xl">
      <div id="github-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {githubRepos.map((repo, i) => (
          <div
            class="github-repo-item animate-in"
            class:list={[`stagger-${Math.min(i + 1, 8)}`]}
            data-language={repo.language}
            data-name={repo.name}
          >
            <GitHubCard repo={repo} />
          </div>
        ))}
      </div>

      <!-- Empty state -->
      <div id="github-empty-state" class="hidden py-20 text-center">
        <div class="inline-flex items-center justify-center rounded-full bg-muted p-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold">Nenhum repositório encontrado</h3>
        <p class="mt-2 text-sm text-muted-foreground">Tente ajustar os filtros ou buscar por outro termo.</p>
      </div>
    </div>
  </section>

  <!-- Info section -->
  <section class="border-t border-border/40 px-4 py-12">
    <div class="container mx-auto max-w-6xl">
      <div class="rounded-lg border border-border/50 bg-gradient-card p-8">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary/10 shrink-0">
            <Github class="h-6 w-6 text-primary" />
          </div>
          <div>
            <h2 class="text-xl font-semibold">Dados Automáticos</h2>
            <p class="mt-2 text-sm text-muted-foreground max-w-2xl">
              Os dados deste explorador são atualizados automaticamente toda semana via GitHub Action.
              Estrelas, forks e informações dos repositórios são puxados diretamente da API do GitHub.
            </p>
            <div class="mt-4 flex items-center gap-2 text-xs text-muted-foreground">
              <span class="inline-flex items-center gap-1 rounded-full bg-green-500/10 px-2 py-0.5 text-green-500">
                <span class="h-1.5 w-1.5 rounded-full bg-green-500" />
                Atualização semanal (domingo 00:00 UTC)
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 px-2 py-0.5 text-primary">
                <Github class="h-3 w-3" />
                GitHub API
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
