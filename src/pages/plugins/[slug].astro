---
import MainLayout from "../../layouts/MainLayout.astro";
import TagBadge from "../../components/TagBadge.astro";
import PluginCard from "../../components/PluginCard.astro";
import ContentTags from "../../components/ContentTags.astro";
import DidYouKnow from "../../components/DidYouKnow.tsx";
import FavoriteButton from "../../components/FavoriteButton";
import { plugins, getPluginBySlug } from "../../data/plugins";
import { ArrowLeft, ExternalLink, Github, Package, Download } from "lucide-react";

export async function getStaticPaths() {
  return plugins.map((plugin) => ({
    params: { slug: plugin.slug },
    props: { plugin },
  }));
}

const { plugin } = Astro.props;

if (!plugin) {
  return Astro.redirect("/opendex/404");
}

const relatedPlugins = plugins
  .filter((p) => p.slug !== plugin.slug && p.category === plugin.category)
  .slice(0, 3);

function getGitHubUrl(repo: string | null): string | null {
  if (!repo) return null;
  const match = repo.match(
    /(?:https?:\/\/|git@|git\+https?:\/\/)(?:www\.)?(?:github\.com\/)([^/]+\/[^/.]+)/i,
  );
  if (match) return `https://github.com/${match[1]}`;
  if (repo.includes('github.com')) {
    const m = repo.match(/(https?:\/\/github\.com\/[^/\s]+(?:\/[^/\s]+?)?)/i);
    if (m) return m[1]?.replace(/\.git$/, '');
  }
  return null;
}

const githubUrl = getGitHubUrl(plugin.repository);
---

<MainLayout title={`${plugin.name} — Plugins — OpenDex`} description={plugin.description}>
  <!-- Breadcrumb -->
  <div class="border-b border-border/40 px-4 py-3">
    <div class="container mx-auto max-w-4xl">
      <nav class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/opendex/plugins/" class="hover:text-foreground transition-colors">Plugins</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-foreground font-medium">{plugin.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-10 pb-12 md:pt-16 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-4xl relative">
      <a href="/opendex/plugins/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
        <ArrowLeft class="h-4 w-4" />
        Voltar para Plugins
      </a>

      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-4 mb-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
              <Package class="h-7 w-7 text-primary" />
            </div>
            <div>
              <span class="inline-flex items-center rounded-full border border-border/50 bg-muted/50 px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                {plugin.category}
              </span>
            </div>
          </div>
          <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl">
            {plugin.name}
          </h1>
          <div class="flex items-center gap-3 mt-2">
            <span class="inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-400 border border-emerald-500/20">
              v{plugin.version}
            </span>
          </div>
          <p class="mt-3 text-lg text-muted-foreground">
            {plugin.description}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            {plugin.tags?.length > 0 && <ContentTags tags={plugin.tags} />}
          </div>
          <div class="mt-4 flex items-center gap-4 text-sm text-muted-foreground">
            <span>{plugin.downloads.toLocaleString()} downloads/mês</span>
            <span>•</span>
            <span>publicado por <span class="font-medium text-foreground">{plugin.author}</span></span>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <a
            href={plugin.npm}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:bg-primary/90"
          >
            <ExternalLink class="h-4 w-4" />
            Ver no npm
          </a>
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-border bg-background px-5 py-2.5 text-sm font-medium transition-colors hover:bg-muted"
            >
              <Github class="h-4 w-4" />
              GitHub
            </a>
          )}
          <FavoriteButton
            type="plugin"
            slug={plugin.slug}
            title={plugin.name}
            url={plugin.npm}
            client:load
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <div class="container mx-auto max-w-4xl px-4 py-10">
    <div class="grid gap-10 lg:grid-cols-3">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-10">
        <section>
          <h2 class="text-xl font-bold mb-4">Descrição</h2>
          <p class="text-muted-foreground leading-relaxed text-lg">
            {plugin.description}
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold mb-4">Instalação</h2>
          <div class="rounded-lg border border-border bg-card p-5">
            <code class="block rounded-md bg-muted px-3 py-2 text-sm font-mono text-foreground">
              npm install {plugin.name}
            </code>
            <button
              class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:bg-primary/90"
              data-copy={`npm install ${plugin.name}`}
            >
              <Download class="h-4 w-4" />
              Copiar comando
            </button>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- Tags -->
        {plugin.tags && plugin.tags.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-5">
            <h3 class="font-semibold mb-3">Tags</h3>
            <div class="flex flex-wrap gap-1.5">
              {plugin.tags.map((tag) => (
                <TagBadge tag={tag} variant="primary" />
              ))}
            </div>
          </div>
        )}

        <!-- Quick Info -->
        <div class="rounded-lg border border-border bg-card p-5">
          <h3 class="font-semibold mb-3">Informações</h3>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Autor</dt>
              <dd class="font-medium">{plugin.author}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Categoria</dt>
              <dd>
                <span class="inline-flex items-center rounded-full border border-border/50 bg-muted/50 px-2 py-0.5 text-[10px] font-medium">
                  {plugin.category}
                </span>
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Versão</dt>
              <dd class="font-medium">{plugin.version}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-muted-foreground">Downloads/mês</dt>
              <dd class="font-medium">{plugin.downloads.toLocaleString()}</dd>
            </div>
          </dl>
        </div>

        <!-- Fonte -->
        <div class="rounded-lg border border-border bg-card p-5">
          <h3 class="font-semibold mb-3">Fonte</h3>
          <a
            href={plugin.npm}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-primary hover:underline break-all"
          >
            {plugin.npm}
          </a>
          <p class="mt-2 text-xs text-muted-foreground">
            Dados do registro npm (snapshot do ecossistema OpenCode).
          </p>
        </div>
      </aside>
    </div>

    <!-- Did You Know -->
    <div class="mt-16">
      <DidYouKnow />
    </div>

    <!-- Related Plugins -->
    {relatedPlugins.length > 0 && (
      <section class="mt-16 border-t border-border/40 pt-10">
        <h2 class="text-xl font-bold mb-6">Plugins relacionados</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPlugins.map((related) => (
            <PluginCard plugin={related} />
          ))}
        </div>
      </section>
    )}
  </div>
</MainLayout>

<script>
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy");
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML =
          '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline h-4 w-4 text-green-500"><path d="M20 6 9 17l-5-5"/></svg> Copiado!';
        setTimeout(() => {
          btn.innerHTML = original;
        }, 2000);
      } catch {
        // ignore clipboard errors
      }
    });
  });
</script>
