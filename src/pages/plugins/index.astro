---
import MainLayout from "../../layouts/MainLayout.astro";
import LiveNpmPackages from "../../components/LiveNpmPackages";
import { packages } from "../../data/npm";
import { Sparkles } from "lucide-react";
---

<MainLayout
  title="Plugins — OpenDex"
  description="Plugins e extensões reais do ecossistema OpenCode. Instale com um comando."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-hero">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        <span>Plugins do ecossistema</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Plugins
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Plugins e extensões reais do ecossistema OpenCode. Instale com um comando.
      </p>

      <div class="mt-4 flex items-center justify-center gap-2 text-sm text-muted-foreground">
        <Sparkles class="h-4 w-4 text-primary" />
        <span>{packages.filter(p => p.keywords?.includes?.('plugin')).length}+ plugins no npm</span>
      </div>
    </div>
  </section>

  <!-- npm Packages -->
  <section class="px-4 py-12 md:py-16">
    <div class="container mx-auto max-w-6xl">
      <h2 class="text-2xl font-bold mb-6">Plugins no npm</h2>
      <p class="text-muted-foreground mb-8">Plugins reais do ecossistema OpenCode disponíveis no npm.</p>
      <LiveNpmPackages client:load defaultCategory="plugin" />
    </div>
  </section>
</MainLayout>
