---
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import BlogCard from "../../components/BlogCard.astro";
import CommunityShowcase from "../../components/CommunityShowcase.astro";
import UsefulLinks from "../../components/UsefulLinks";
import readingTime from "reading-time";
import { getCollection } from "astro:content";
import { Newspaper, Sparkles, Tag } from "lucide-react";

const posts = await getCollection("blog");
const published = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = published.filter((p) => p.data.featured);

const totalMinutes = Math.round(
  published.reduce((acc, p) => acc + readingTime(p.body ?? '').minutes, 0)
);

// Collect all tags and categories
const allTags = [...new Set(published.flatMap((p) => p.data.tags))];
const allCategories = [...new Set(published.flatMap((p) => p.data.categories))];
---

<MainLayout title="Blog — OpenDex" description="Novidades, tutoriais e análises sobre o ecossistema OpenCode">
  <Breadcrumb items={[{ label: "Blog" }]} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <Newspaper class="h-4 w-4 text-primary" />
        <span>Blog</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Blog
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Novidades, tutoriais, releases e análises sobre o ecossistema OpenCode.
      </p>
      <div class="mt-6 flex items-center justify-center gap-2 text-sm text-muted-foreground">
        <Sparkles class="h-4 w-4 text-primary" />
        <span>{published.length} artigos · {Math.round(totalMinutes)} min de leitura</span>
      </div>
    </div>
  </section>

  <div class="container mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-10 lg:grid-cols-[1fr_300px]">
      <!-- Main Content: Latest Articles -->
      <div>
        <!-- Featured Posts -->
        {featured.length > 0 && (
          <section class="mb-12">
            <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
              <Sparkles class="h-5 w-5 text-primary" />
              Destaques
            </h2>
            <div class="grid gap-6 sm:grid-cols-2">
              {featured.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          </section>
        )}

        <!-- All Posts -->
        <section>
          <h2 class="text-xl font-bold mb-6">Todos os artigos</h2>
          {published.length > 0 ? (
            <div class="grid gap-6 sm:grid-cols-2">
              {published.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
          ) : (
            <div class="py-16 text-center">
              <div class="inline-flex items-center justify-center rounded-full bg-muted p-4">
                <Newspaper class="h-6 w-6 text-muted-foreground" />
              </div>
              <h3 class="mt-4 text-lg font-semibold">Nenhum artigo publicado ainda</h3>
              <p class="mt-2 text-sm text-muted-foreground">Volte em breve para novos conteúdos.</p>
            </div>
          )}
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-8">
          <!-- Categories -->
          {allCategories.length > 0 && (
            <div class="rounded-lg border border-border bg-card p-5">
              <h3 class="font-semibold mb-3 flex items-center gap-2 text-sm">
                <Tag class="h-4 w-4 text-primary" />
                Categorias
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {allCategories.map((cat) => (
                  <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
                    {cat}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Tags -->
          {allTags.length > 0 && (
            <div class="rounded-lg border border-border bg-card p-5">
              <h3 class="font-semibold mb-3 flex items-center gap-2 text-sm">
                <Tag class="h-4 w-4 text-primary" />
                Tags
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {allTags.map((tag) => (
                  <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Community Showcase -->
          <CommunityShowcase />

          <!-- Useful Links -->
          <UsefulLinks client:idle />
        </div>
      </aside>
    </div>
  </div>
</MainLayout>
