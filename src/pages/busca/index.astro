---
import MainLayout from "../../layouts/MainLayout.astro";
import GlobalSearch from "../../components/GlobalSearch";
import { Search } from "lucide-react";
---

<MainLayout
  title="Busca — OpenDex"
  description="Busque por modelos, plugins, MCPs, scripts e mais no ecossistema OpenCode."
>
  <section class="px-4 pt-16 pb-12 md:pt-24 md:pb-16 border-b border-border/40">
    <div class="container mx-auto max-w-6xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <Search class="h-4 w-4 text-primary" />
        <span>Busca Global</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
        Buscar no Ecossistema
      </h1>
      <p class="mx-auto mt-2 max-w-2xl text-lg text-muted-foreground">
        Encontre qualquer coisa no OpenDex — modelos, plugins, ferramentas, documentação e mais.
      </p>
    </div>
  </section>

  <section class="px-4 py-10">
    <div class="container mx-auto max-w-6xl">
      <GlobalSearch client:load />
    </div>
  </section>
</MainLayout>
