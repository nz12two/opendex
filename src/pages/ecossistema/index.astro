---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import {
  Globe,
  Code,
  Users,
  Puzzle,
  Server,
  Brain,
  Workflow,
  FolderKanban,
  GitCompare,
  Wrench,
  Newspaper,
  Sparkles,
} from "lucide-react";
import { scripts } from "../../data/scripts";
import { agents } from "../../data/agents";
import { plugins } from "../../data/plugins";
import { mcps } from "../../data/mcps";
import { models } from "../../data/models";
import { workflows } from "../../data/workflows";
import { projects } from "../../data/showcase";
import { comparisons } from "../../data/comparisons";
import { tools } from "../../data/tools";
import ecosystemStats from "../../data/ecosystem/stats.json";
import { packages as npmPackages } from "../../data/npm";

const blogPosts = await getCollection("blog");
const publishedBlogPosts = blogPosts.filter(
  (p) => !p.data.draft && p.id !== "index.mdx"
);

const pluginCount = npmPackages.filter(p => p.keywords?.includes?.('plugin')).length || 0;
const mcpCount = npmPackages.filter(p => p.keywords?.includes?.('mcp')).length || 0;

interface CategoryCard {
  title: string;
  description: string;
  href: string;
  icon: typeof Globe;
  count: number | string;
  label: string;
}

const categories: CategoryCard[] = [
  {
    title: "Scripts",
    description: "Como npm, mas para OpenCode. Descubra e compartilhe scripts prontos para usar.",
    href: "/opendex/scripts/",
    icon: Code,
    count: ecosystemStats.packages.total.toLocaleString() + "+",
    label: "pacotes npm",
  },
  {
    title: "Agentes",
    description: "Agentes especializados prontos para usar no seu workflow. Cada um focado em uma função.",
    href: "/opendex/agents/",
    icon: Users,
    count: agents.length,
    label: "agentes",
  },
  {
    title: "Plugins",
    description: "Marketplace de plugins e extensões para turbinar seu OpenCode com novas capacidades.",
    href: "/opendex/plugins/",
    icon: Puzzle,
    count: pluginCount,
    label: "plugins",
  },
  {
    title: "MCPs",
    description: "Conecte seu OpenCode com ferramentas externas via Model Context Protocol.",
    href: "/opendex/mcps/",
    icon: Server,
    count: mcpCount,
    label: "MCPs",
  },
  {
    title: "Modelos",
    description: "Modelos de linguagem compatíveis com o OpenCode, do gratuito ao premium.",
    href: "/opendex/modelos/",
    icon: Brain,
    count: "342+",
    label: "modelos",
  },
  {
    title: "Workflows",
    description: "Workflows pré-definidos para automatizar seu desenvolvimento com agentes em série.",
    href: "/opendex/workflows/",
    icon: Workflow,
    count: workflows.length,
    label: "workflows",
  },
  {
    title: "Showcase",
    description: "Projetos incríveis criados pela comunidade OpenCode para inspirar você.",
    href: "/opendex/showcase/",
    icon: FolderKanban,
    count: projects.length,
    label: "projetos",
  },
  {
    title: "Comparações",
    description: "Compare OpenCode com outras ferramentas de coding assistido por IA.",
    href: "/opendex/comparacoes/",
    icon: GitCompare,
    count: comparisons.length,
    label: "comparações",
  },
  {
    title: "Ferramentas",
    description: "Ferramentas úteis para criar, configurar e otimizar seu OpenCode.",
    href: "/opendex/ferramentas/",
    icon: Wrench,
    count: tools.length,
    label: "ferramentas",
  },
  {
    title: "Blog",
    description: "Novidades, tutoriais, releases e análises sobre o ecossistema OpenCode.",
    href: "/opendex/blog/",
    icon: Newspaper,
    count: publishedBlogPosts.length,
    label: "artigos",
  },
];
---

<MainLayout
  title="Ecossistema — OpenDex"
  description="Explore todo o ecossistema OpenCode em um só lugar: scripts, agentes, plugins, MCPs, modelos e muito mais."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-hero">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <Globe class="h-4 w-4 text-primary" />
        <span>Ecossistema</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Ecossistema OpenCode
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Explore todo o ecossistema em um só lugar. Descubra scripts, agentes, plugins, MCPs e muito mais.
      </p>
      <div class="mt-6 flex items-center justify-center gap-2 text-sm text-muted-foreground">
        <Sparkles class="h-4 w-4 text-primary" />
        <span>
          {ecosystemStats.packages.total.toLocaleString()} pacotes npm · 342+ modelos · {ecosystemStats.github.totalEcosystemStars.toLocaleString()} ⭐ no GitHub
        </span>
      </div>
    </div>
  </section>

  <!-- Grid de Categorias -->
  <section class="px-4 py-12 md:py-16">
    <div class="container mx-auto max-w-6xl">
      <div class="grid gap-6 sm:grid-cols-2">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class="group relative overflow-hidden rounded-lg border border-border/50 bg-card p-6 transition-all hover:border-primary/50 hover:shadow-md hover:shadow-primary/5"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20">
                <cat.icon class="h-6 w-6 text-primary" />
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-semibold transition-colors group-hover:text-primary">
                    {cat.title}
                  </h3>
                  <span class="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary whitespace-nowrap shrink-0">
                    {cat.count} {cat.label}
                  </span>
                </div>
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                  {cat.description}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section class="border-t border-border/40 px-4 py-12 md:py-16">
    <div class="container mx-auto max-w-6xl">
      <div class="rounded-lg border border-border/50 bg-card p-8 md:p-12 text-center">
        <Globe class="mx-auto h-10 w-10 text-primary mb-4" />
        <h2 class="text-2xl font-bold md:text-3xl">
          Um ecossistema em crescimento
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-muted-foreground">
          O OpenCode é construído pela comunidade. Contribua com scripts, plugins, agentes e ajude a expandir ainda mais este ecossistema.
        </p>
        <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="https://github.com/anomalyco/opencode"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:bg-primary/90 hover:shadow-xl hover:shadow-primary/30"
          >
            Contribuir no GitHub
          </a>
          <a
            href="/opendex/docs/"
            class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-6 py-3 text-sm font-medium transition-colors hover:bg-muted"
          >
            Documentação
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
