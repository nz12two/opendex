---
import MainLayout from "../../layouts/MainLayout.astro";
import CuriosityCard from "../../components/CuriosityCard";
import CuriosityFilters from "../../components/CuriosityFilters.astro";
import { curiosities, getCuriosityCategories } from "../../data/curiosities";
import { Sparkles } from "lucide-react";

const categories = getCuriosityCategories();
const { category } = Astro.url.searchParams;
const activeCategory = category && categories.includes(category) ? category : "all";

const filtered = activeCategory === "all"
  ? curiosities
  : curiosities.filter(c => c.category === activeCategory);
---

<MainLayout
  title="Curiosidades — OpenDex"
  description="Fatos verificáveis sobre o ecossistema OpenCode, todos com fonte."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-hero">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        <span>Você Sabia?</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Curiosidades
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Fatos reais do ecossistema OpenCode, cada um com a fonte de onde foi puxado.
      </p>

      <div class="mt-4 flex items-center justify-center gap-2 text-sm text-muted-foreground">
        <Sparkles class="h-4 w-4 text-primary" />
        <span>{curiosities.length} curiosidades</span>
      </div>
    </div>
  </section>

  <!-- Filters -->
  <section class="border-b border-border/40 px-4 py-4">
    <div class="container mx-auto max-w-6xl">
      <CuriosityFilters activeCategory={activeCategory} />
    </div>
  </section>

  <!-- Results info -->
  <section class="border-b border-border/40 px-4 py-3">
    <div class="container mx-auto max-w-6xl flex items-center justify-between">
      <p class="text-sm text-muted-foreground">
        {filtered.length} curiosidade(s)
        {activeCategory !== 'all' && <span> em <strong>{activeCategory}</strong></span>}
      </p>
    </div>
  </section>

  <!-- Grid -->
  <section class="px-4 py-10">
    <div class="container mx-auto max-w-6xl">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {filtered.map((curiosity, i) => (
          <div class={`animate-in stagger-${Math.min(i + 1, 8)}`}>
            <CuriosityCard curiosity={curiosity} client:load />
          </div>
        ))}
      </div>
      {filtered.length === 0 && (
        <div class="py-20 text-center">
          <div class="inline-flex items-center justify-center rounded-full bg-muted p-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          </div>
          <h3 class="mt-4 text-lg font-semibold">Nenhuma curiosidade encontrada</h3>
          <p class="mt-2 text-sm text-muted-foreground">Tente selecionar outra categoria.</p>
        </div>
      )}
    </div>
  </section>
</MainLayout>
