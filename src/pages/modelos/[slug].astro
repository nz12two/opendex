---
import MainLayout from "../../layouts/MainLayout.astro";
import ModelSpecs from "../../components/ModelSpecs.astro";
import ModelRating from "../../components/ModelRating";
import { SourceBadge } from "../../components/SourceBadge";
import { getModelBySlug, models, getCategoryLabel, getCategoryColor } from "../../data/models";
import { ArrowLeft, Brain, Star, Check, X, ExternalLink } from "lucide-react";
import { cn } from '@/lib/utils';

export async function getStaticPaths() {
  return models.map((model) => ({
    params: { slug: model.slug },
    props: { model },
  }));
}

const { model } = Astro.props;

if (!model) {
  return Astro.redirect("/opendex/404");
}

const relatedModels = models.filter((m) => m.slug !== model.slug).slice(0, 3);
---

<MainLayout title={`${model.name} — Modelos — OpenDex`} description={model.description || `${model.name}: ${model.provider}, ${model.price}, ${model.context >= 1000000 ? (model.context / 1000000).toFixed(0) + 'M' : (model.context / 1000).toFixed(0) + 'K'} tokens de contexto`}>
  <!-- Breadcrumb -->
  <div class="border-b border-border/40 px-4 py-3">
    <div class="container mx-auto max-w-4xl">
      <nav class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/opendex/modelos/" class="hover:text-foreground transition-colors">Modelos</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-foreground font-medium">{model.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-10 pb-12 md:pt-16 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-4xl relative">
      <a href="/opendex/modelos/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
        <ArrowLeft class="h-4 w-4" />
        Voltar para Modelos
      </a>

      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-4 mb-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
              <Brain class="h-7 w-7 text-primary" />
            </div>
            <div>
              <div class="flex items-center gap-3">
                <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
                  {model.name}
                </h1>
                <span class={cn('inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium', getCategoryColor(model.category))}>
                  {getCategoryLabel(model.category)}
                </span>
              </div>
              {model.provider && (
                <p class="text-sm text-muted-foreground mt-1">{model.provider}</p>
              )}
            </div>
          </div>
          {model.description && (
            <p class="mt-2 text-lg text-muted-foreground max-w-2xl">
              {model.description}
            </p>
          )}
          <div class="flex items-center gap-3 mt-2">
            <SourceBadge source="openrouter" />
          </div>
          <div class="mt-4 flex items-center gap-2">
            <ModelRating rating={model.communityRating} />
            <span class="text-sm text-muted-foreground">Comunidade</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <div class="container mx-auto max-w-4xl px-4 py-10">
    <!-- Specs -->
    <section class="mb-12">
      <h2 class="text-xl font-bold mb-6">Especificações</h2>
      <ModelSpecs model={model} />
    </section>

    <!-- Pros & Cons -->
    <div class="grid gap-8 md:grid-cols-2 mb-12">
      <div>
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <Check class="h-5 w-5 text-emerald-500" />
          Vantagens
        </h2>
        <ul class="space-y-3">
          {model.pros.map((pro) => (
            <li class="flex items-start gap-3 rounded-lg border border-emerald-500/20 bg-emerald-500/5 p-4">
              <Check class="mt-0.5 h-4 w-4 shrink-0 text-emerald-500" />
              <span class="text-sm text-muted-foreground">{pro}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <X class="h-5 w-5 text-red-500" />
          Desvantagens
        </h2>
        <ul class="space-y-3">
          {model.cons.map((con) => (
            <li class="flex items-start gap-3 rounded-lg border border-red-500/20 bg-red-500/5 p-4">
              <X class="mt-0.5 h-4 w-4 shrink-0 text-red-500" />
              <span class="text-sm text-muted-foreground">{con}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Related -->
    {relatedModels.length > 0 && (
      <section class="border-t border-border/40 pt-10">
        <h2 class="text-xl font-bold mb-6">Modelos relacionados</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedModels.map((related) => (
            <a
              href={`/opendex/modelos/${related.slug}/`}
              class="group rounded-lg border border-border/50 bg-card p-4 transition-all hover:border-primary/30"
            >
              <div class="flex items-center gap-3 mb-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10">
                  <Brain class="h-4 w-4 text-primary" />
                </div>
                <h3 class="font-semibold group-hover:text-primary transition-colors">{related.name}</h3>
              </div>
              <p class="text-sm text-muted-foreground line-clamp-2">{related.description}</p>
              <div class="mt-2 flex items-center gap-1 text-xs text-amber-500">
                <Star class="h-3 w-3" />
                <span>{related.communityRating}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</MainLayout>


