---
import MainLayout from "../../layouts/MainLayout.astro";
import TagBadge from "../../components/TagBadge.astro";
import { getAgentBySlug, agents } from "../../data/agents";
import DifficultyBadge from "../../components/DifficultyBadge.tsx";
import DidYouKnow from "../../components/DidYouKnow.tsx";
import ContentTags from "../../components/ContentTags.astro";
import FavoriteButton from "../../components/FavoriteButton";
import { ArrowLeft, ArrowRight } from "lucide-react";

export async function getStaticPaths() {
  return agents.map((agent) => ({
    params: { slug: agent.slug },
    props: { agent },
  }));
}

const { agent } = Astro.props;

if (!agent) {
  return Astro.redirect("/opendex/404");
}

const relatedAgents = agents.filter((a) => a.slug !== agent.slug).slice(0, 3);
---

<MainLayout title={`${agent.name} — Agentes — OpenDex`} description={agent.description}>
  <!-- Breadcrumb -->
  <div class="border-b border-border/40 px-4 py-3">
    <div class="container mx-auto max-w-4xl">
      <nav class="flex items-center gap-2 text-sm text-muted-foreground">
        <a href="/opendex/agents/" class="hover:text-foreground transition-colors">Agentes</a>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-foreground font-medium">{agent.name}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-10 pb-12 md:pt-16 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-4xl relative">
      <a href="/opendex/agents/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6">
        <ArrowLeft class="h-4 w-4" />
        Voltar para Agentes
      </a>

      <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10">
              <span class="text-2xl font-bold text-primary">{agent.name.charAt(0)}</span>
            </div>
          </div>
          <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl">
            {agent.name}
          </h1>
          <p class="mt-3 text-lg text-muted-foreground">
            {agent.description}
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <DifficultyBadge difficulty="intermediate" size="sm" />
            {agent.tags?.length > 0 && <ContentTags tags={agent.tags} />}
          </div>
          <div class="mt-5 flex items-start gap-3 rounded-lg border border-amber-500/30 bg-amber-500/5 px-4 py-3 text-xs text-muted-foreground">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500 shrink-0 mt-0.5"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
            <span><span class="font-semibold text-foreground">Exemplo didático.</span> Perfil genérico de configuração — não é um agente ou produto oficial do OpenCode.</span>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <FavoriteButton
            type="agente"
            slug={agent.slug}
            title={agent.name}
            url={`/opendex/agents/${agent.slug}/`}
            client:load
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <div class="container mx-auto max-w-4xl px-4 py-10">
    <div class="grid gap-10 lg:grid-cols-3">
      <!-- Main -->
      <div class="lg:col-span-2 space-y-10">
        <!-- O que faz -->
        <section>
          <h2 class="text-xl font-bold mb-4">O que faz</h2>
          <p class="text-muted-foreground leading-relaxed text-lg">
            {agent.whatItDoes}
          </p>
        </section>

        <!-- Quando usar -->
        <section>
          <h2 class="text-xl font-bold mb-4">Quando usar</h2>
          <div class="rounded-lg border border-border bg-card p-5">
            <p class="text-muted-foreground leading-relaxed">
              {agent.whenToUse}
            </p>
          </div>
        </section>

        <!-- Exemplo -->
        <section>
          <h2 class="text-xl font-bold mb-4">Exemplo de uso</h2>
          <div class="rounded-lg border border-border bg-muted/30 p-5">
            <p class="text-muted-foreground leading-relaxed italic">
              "{agent.example}"
            </p>
          </div>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- Inputs -->
        <div class="rounded-lg border border-border bg-card p-5">
          <h3 class="font-semibold mb-3 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
            Inputs
          </h3>
          <ul class="space-y-2">
            {agent.inputs.map((input) => (
              <li class="flex items-start gap-2 text-sm">
                <span class="mt-0.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60" />
                <span class="text-muted-foreground">{input}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Outputs -->
        <div class="rounded-lg border border-border bg-card p-5">
          <h3 class="font-semibold mb-3 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 4v16"/><path d="M4 12h16"/></svg>
            Outputs
          </h3>
          <ul class="space-y-2">
            {agent.outputs.map((output) => (
              <li class="flex items-start gap-2 text-sm">
                <span class="mt-0.5 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500/60" />
                <span class="text-muted-foreground">{output}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Tags -->
        {agent.tags && agent.tags.length > 0 && (
          <div class="rounded-lg border border-border bg-card p-5">
            <h3 class="font-semibold mb-3">Tags</h3>
            <div class="flex flex-wrap gap-1.5">
              {agent.tags.map((tag) => (
                <TagBadge tag={tag} variant="primary" />
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <!-- Did You Know -->
    <div class="mt-16">
      <DidYouKnow />
    </div>

    <!-- Related -->
    {relatedAgents.length > 0 && (
      <section class="mt-16 border-t border-border/40 pt-10">
        <h2 class="text-xl font-bold mb-6">Agentes relacionados</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedAgents.map((related) => (
            <a
              href={`/opendex/agents/${related.slug}/`}
              class="group rounded-lg border border-border/50 bg-card p-4 transition-all hover:border-primary/30"
            >
              <div class="flex items-center gap-3 mb-2">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10">
                  <span class="text-sm font-bold text-primary">{related.name.charAt(0)}</span>
                </div>
                <h3 class="font-semibold group-hover:text-primary transition-colors">{related.name}</h3>
              </div>
              <p class="text-sm text-muted-foreground line-clamp-2">{related.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</MainLayout>
