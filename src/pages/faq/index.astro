---
import MainLayout from "../../layouts/MainLayout.astro";
import FAQAccordion from "../../components/FAQAccordion";
import FAQCategory from "../../components/FAQCategory.astro";
import { faqItems, getFAQCategories, categoryLabels } from "../../data/faq";
import { HelpCircle, MessageCircle } from "lucide-react";

const categories = getFAQCategories();
const activeCategory = Astro.url.searchParams.get("categoria");
const filteredItems = activeCategory
  ? faqItems.filter((item) => item.category === activeCategory)
  : faqItems;

const allBtnClass = !activeCategory 
  ? 'ring-2 ring-primary/30 border-primary/30 bg-primary/5 text-primary font-semibold' 
  : 'border-border/50 bg-background text-muted-foreground hover:border-primary/40 hover:text-foreground hover:bg-muted/30 transition-all';
---

<MainLayout
  title="FAQ — OpenDex"
  description="Perguntas frequentes sobre OpenCode: conceitos, economia, modelos, instalação, criação e cache."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-4xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <HelpCircle class="h-4 w-4 text-primary" />
        <span>FAQ</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Perguntas Frequentes
      </h1>
      <p class="mx-auto mt-2 max-w-2xl text-lg text-muted-foreground">
        Tire suas dúvidas sobre OpenCode — conceitos, economia, modelos, instalação, criação e cache.
      </p>
    </div>
  </section>

  <!-- Categories -->
  <section class="px-4 py-8 border-b border-border/40">
    <div class="container mx-auto max-w-3xl">
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a
          href="/opendex/faq/"
          class="inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition-all duration-200 {allBtnClass}"
        >
          Todas
          <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 rounded-full bg-background/50 px-1 text-[10px] font-bold">
            {faqItems.length}
          </span>
        </a>
        {
          categories.map((cat) => {
            const count = faqItems.filter((item) => item.category === cat).length;
            const isActive = activeCategory === cat;
            const href = isActive ? "/opendex/faq/" : `/opendex/faq/?categoria=${cat}`;
            const label = categoryLabels[cat] || cat;
            return (
              <a
                href={href}
                class={`inline-flex items-center gap-1.5 rounded-full border px-4 py-1.5 text-xs font-medium transition-all duration-200 ${isActive ? 'ring-2 ring-primary/30 border-primary/30 bg-primary/5 text-primary' : 'border-border/50 bg-background text-muted-foreground hover:border-primary/40 hover:text-foreground'}`}
              >
                {label}
                <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 rounded-full bg-background/60 px-1.5 text-[10px] font-bold">
                  {count}
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- FAQ Accordion -->
  <section class="px-4 py-10 md:py-16">
    <div class="container mx-auto max-w-3xl">
      <FAQAccordion items={filteredItems} categoryFilter={activeCategory} client:load />
    </div>
  </section>

  <!-- Still have questions -->
  <section class="border-t border-border/40 px-4 py-16">
    <div class="container mx-auto max-w-2xl text-center">
      <div class="flex justify-center mb-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10">
          <MessageCircle class="h-6 w-6 text-primary" />
        </div>
      </div>
      <h2 class="text-xl font-bold mb-2">Ainda tem dúvidas?</h2>
      <p class="text-sm text-muted-foreground mb-6">
        Explore nossa documentação completa ou entre na comunidade no Discord.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a
          href="/opendex/docs/"
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          Ver Documentação
        </a>
        <a
          href="https://discord.gg/opencode"
          class="inline-flex items-center gap-2 rounded-lg border border-border bg-background px-4 py-2 text-sm font-medium hover:bg-muted transition-colors"
        >
          Discord
        </a>
      </div>
    </div>
  </section>
</MainLayout>
