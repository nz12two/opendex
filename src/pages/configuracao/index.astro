---
import MainLayout from "../../layouts/MainLayout.astro";
import SetupGuideCard from "../../components/SetupGuideCard.astro";
import { setupGuides } from "../../data/setup-guides";
import { Wrench, Sparkles } from "lucide-react";
---

<MainLayout title="Configuração — OpenDex" description="Guias passo a passo para configurar provedores de IA no OpenCode. OpenRouter, Gemini, Claude, GPT e mais.">
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-hero">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <Wrench class="h-4 w-4 text-primary" />
        <span>Guias de Configuração</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Configuração
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Aprenda a configurar cada provedor de IA no OpenCode. Guias passo a passo com exemplos práticos de código.
      </p>
      <div class="mt-6 flex items-center justify-center gap-2 text-sm text-muted-foreground">
        <Sparkles class="h-4 w-4 text-primary" />
        <span>{setupGuides.length} guias disponíveis</span>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="px-4 py-10">
    <div class="container mx-auto max-w-6xl">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {setupGuides.map((guide, i) => (
          <div class={`animate-in stagger-${Math.min(i + 1, 8)}`}>
            <SetupGuideCard guide={guide} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Info -->
  <section class="border-t border-border/40 px-4 py-10">
    <div class="container mx-auto max-w-4xl">
      <div class="rounded-lg border border-border bg-card p-8 text-center">
        <h2 class="text-xl font-bold mb-3">Provedor não listado?</h2>
        <p class="text-muted-foreground max-w-lg mx-auto">
          O OpenCode suporta qualquer provedor compatível com a API OpenAI. Consulte a documentação oficial para configurações avançadas.
        </p>
        <a href="/opendex/docs/api" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
          Ver documentação da API
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </section>
</MainLayout>
