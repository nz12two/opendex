---
import MainLayout from "../../layouts/MainLayout.astro";
import ToolCard from "../../components/ToolCard.astro";
import { tools } from "../../data/tools";
import { Wrench, Sparkles } from "lucide-react";
---

<MainLayout
  title="Ferramentas — OpenDex"
  description="Ferramentas interativas para criar, configurar e otimizar seu OpenCode."
  image="/opendex/og/ferramentas.png"
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16 bg-gradient-hero">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <Wrench class="h-4 w-4 text-primary" />
        <span>Ferramentas interativas</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Ferramentas
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Ferramentas interativas para criar, configurar e otimizar seu OpenCode.
      </p>

      <div class="mt-4 flex items-center justify-center gap-2 text-sm text-muted-foreground">
        <Sparkles class="h-4 w-4 text-primary" />
        <span>{tools.length} ferramentas disponíveis</span>
      </div>
    </div>
  </section>

  <!-- Tools Grid -->
  <section class="px-4 py-12 md:py-16">
    <div class="container mx-auto max-w-6xl">
      <div class="mb-8 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
          <Wrench class="h-5 w-5 text-primary" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-foreground">Ferramentas interativas</h2>
          <p class="text-sm text-muted-foreground">
            Crie, configure e otimize seu OpenCode direto no navegador
          </p>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((tool) => (
          <ToolCard tool={tool} />
        ))}
      </div>
    </div>
  </section>
</MainLayout>
