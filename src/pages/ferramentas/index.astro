---
import MainLayout from "../../layouts/MainLayout.astro";
import LiveNpmPackages from "../../components/LiveNpmPackages.tsx";
import { Sparkles } from "lucide-react";
---

<MainLayout
  title="Ferramentas — OpenDex"
  description="Pacotes npm reais do ecossistema OpenCode. Instale com um comando."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-6xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        <span>📦 Dados do npm</span>
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Ferramentas
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted-foreground">
        Pacotes npm reais do ecossistema OpenCode. Instale com um comando.
      </p>

      <div class="mt-4 flex items-center justify-center gap-2 text-sm text-muted-foreground">
        <Sparkles class="h-4 w-4 text-primary" />
        <span>46+ pacotes disponíveis</span>
      </div>
    </div>
  </section>

  <!-- NPM Section -->
  <section class="px-4 py-12 md:py-16">
    <div class="container mx-auto max-w-6xl">
      <div class="mb-8 flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-foreground">🔧 Ferramentas no npm</h2>
          <p class="text-sm text-muted-foreground">
            Pacotes npm relacionados ao ecossistema OpenCode disponíveis no registro público
          </p>
        </div>
      </div>
      <LiveNpmPackages client:load />
    </div>
  </section>
</MainLayout>
