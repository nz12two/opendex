---
import MainLayout from "../../layouts/MainLayout.astro";
import DiscoverApp from "../../components/DiscoverApp";
import { Compass, Sparkles } from "lucide-react";
---

<MainLayout
  title="Descobrir — OpenDex"
  description="Responda 4 perguntas e descubra o setup ideal do OpenCode para seu projeto."
>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border/40 px-4 pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-transparent pointer-events-none" />
    <div class="container mx-auto max-w-4xl text-center relative">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/50 px-4 py-1.5 text-sm text-muted-foreground mb-6">
        <Compass class="h-4 w-4 text-primary" />
        <span>Questionário Inteligente</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl">
        Descubra seu setup ideal
      </h1>
      <p class="mx-auto mt-2 max-w-2xl text-lg text-muted-foreground">
        Responda 4 perguntas rápidas sobre seu projeto e receba recomendações 
        personalizadas de agentes, plugins, MCPs e ferramentas.
      </p>
    </div>
  </section>

  <!-- Questionário -->
  <section class="px-4 py-10 md:py-16">
    <div class="container mx-auto max-w-4xl">
      <DiscoverApp client:load />
    </div>
  </section>
</MainLayout>
